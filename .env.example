# Sandbox deploy settings (copy to .env and edit)
DEPLOY_HOST=HOST
DEPLOY_PORT=PORT
DEPLOY_USER=USER
# OpenSSH private key (sibling of rawb_tv.ppk — scp cannot use .ppk directly)
DEPLOY_SSH_KEY=PATH_TO_SSH_KEY
# Remote datapacks folder (absolute on the server, or relative to the SSH user home)
DEPLOY_REMOTE_PATH=PATH_TO_REMOTE_PATH
# Zip basename (without .zip)
DEPLOY_PACK_NAME=ZIP_NAME
